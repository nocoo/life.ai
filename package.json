{
	"name": "life.ai",
	"version": "2.0.2",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.0",
	"engines": {
		"node": "^22.20.0 || ^24.0.0 || >=26.0.0"
	},
	"scripts": {
		"check:node": "node scripts/check-node-version.mjs",
		"predev": "bun run check:node",
		"dev": "CLOUDFLARE_ENV=local vite --host 127.0.0.1",
		"prebuild": "bun run check:node",
		"build": "vite build",
		"prepreview": "bun run check:node",
		"preview": "vite preview --host 127.0.0.1",
		"predeploy": "bun run check:node",
		"deploy": "bun scripts/deploy.ts",
		"precf-typegen": "bun run check:node",
		"cf-typegen": "wrangler types --include-runtime=false --strict-vars=false",
		"pretypecheck": "bun run check:node",
		"typecheck": "bun run cf-typegen && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.tools.json && tsc --noEmit -p tsconfig.test.json",
		"prelint": "bun run check:node",
		"lint": "biome check --error-on-warnings .",
		"prelint:fix": "bun run check:node",
		"lint:fix": "biome check --write .",
		"pretest": "bun run check:node",
		"test": "vitest run",
		"pretest:coverage": "bun run check:node",
		"test:coverage": "vitest run --coverage",
		"preut": "bun run check:node",
		"ut": "bun run test:coverage",
		"pretest:l2": "bun run check:node",
		"test:l2": "bun scripts/run-tests.ts l2",
		"pretest:l3": "bun run check:node",
		"test:l3": "bun scripts/run-tests.ts l3",
		"pregate:security": "bun run check:node",
		"gate:security": "bun scripts/security.ts",
		"quality": "bun run typecheck && bun run lint && bun run test:coverage && bun run build && bun run test:l2 && bun run test:l3 && bun run gate:security",
		"predb:migrate": "bun run check:node",
		"db:migrate": "wrangler d1 migrations apply life-local --config wrangler.jsonc --local --env local --persist-to .wrangler/state",
		"prepare": "husky",
		"predev:prod": "bun run check:node",
		"dev:prod": "CLOUDFLARE_ENV=devprod vite --host 127.0.0.1",
		"predata:import": "bun run check:node",
		"data:import": "bun scripts/import-data.ts",
		"prediary:eval": "bun run check:node",
		"diary:eval": "bun scripts/eval-diary.ts"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "4.0.53",
		"@ai-sdk/openai": "4.0.66",
		"@nocoo/basalt": "2.1.7",
		"@nocoo/next-ai": "0.4.0",
		"@zip.js/zip.js": "2.15.0",
		"ai": "7.0.100",
		"jose": "6.2.12",
		"leaflet": "1.9.4",
		"lucide-react": "1.46.0",
		"papaparse": "5.7.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-router": "8.3.1",
		"recharts": "3.10.1",
		"saxes": "6.0.0",
		"zod": "4.6.5",
		"zustand": "5.0.15"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@biomejs/biome": "2.5.13",
		"@cloudflare/vite-plugin": "1.54.9",
		"@cloudflare/workers-types": "5.20260914.1",
		"@playwright/test": "1.63.0",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/react": "16.3.3",
		"@types/bun": "1.4.2",
		"@types/leaflet": "1.9.22",
		"@types/node": "26.5.1",
		"@types/papaparse": "5.5.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.1",
		"@vitest/coverage-v8": "5.0.0",
		"fake-indexeddb": "6.2.5",
		"husky": "9.1.7",
		"jsdom": "30.0.1",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2",
		"vite": "8.3.0",
		"vitest": "5.0.0",
		"wrangler": "4.131.1"
	},
	"trustedDependencies": [
		"@biomejs/biome",
		"esbuild",
		"workerd"
	]
}
